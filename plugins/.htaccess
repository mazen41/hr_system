RewriteEngine On

# DataTables
RewriteRule ^datatables/jquery.dataTables.min.js$ https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js [R=301,L]
RewriteRule ^datatables-bs4/js/dataTables.bootstrap4.min.js$ https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js [R=301,L]
RewriteRule ^datatables-bs4/css/dataTables.bootstrap4.min.css$ https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css [R=301,L]
RewriteRule ^datatables-responsive/js/dataTables.responsive.min.js$ https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js [R=301,L]
RewriteRule ^datatables-responsive/js/responsive.bootstrap4.min.js$ https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap4.min.js [R=301,L]
RewriteRule ^datatables-responsive/css/responsive.bootstrap4.min.css$ https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap4.min.css [R=301,L]
RewriteRule ^datatables-buttons/js/dataTables.buttons.min.js$ https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js [R=301,L]
RewriteRule ^datatables-buttons/js/buttons.bootstrap4.min.js$ https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap4.min.js [R=301,L]
RewriteRule ^datatables-buttons/css/buttons.bootstrap4.min.css$ https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap4.min.css [R=301,L]
RewriteRule ^datatables-buttons/js/buttons.html5.min.js$ https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js [R=301,L]
RewriteRule ^datatables-buttons/js/buttons.print.min.js$ https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js [R=301,L]
RewriteRule ^datatables-buttons/js/buttons.colVis.min.js$ https://cdn.datatables.net/buttons/2.4.1/js/buttons.colVis.min.js [R=301,L]

# jQuery
RewriteRule ^jquery/jquery.min.js$ https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js [R=301,L]

# Bootstrap
RewriteRule ^bootstrap/js/bootstrap.bundle.min.js$ https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js [R=301,L]

# Font Awesome
RewriteRule ^fontawesome-free/css/all.min.css$ https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css [R=301,L]

# AdminLTE
RewriteRule ^adminlte/js/adminlte.min.js$ https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/js/adminlte.min.js [R=301,L]

# SweetAlert2
RewriteRule ^sweetalert2-theme-bootstrap-4/bootstrap-4.min.css$ https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css [R=301,L]
RewriteRule ^sweetalert2/sweetalert2.min.js$ https://cdn.jsdelivr.net/npm/sweetalert2@11 [R=301,L]

# Toastr
RewriteRule ^toastr/toastr.min.css$ https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css [R=301,L]
RewriteRule ^toastr/toastr.min.js$ https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js [R=301,L]

# Select2
RewriteRule ^select2_n/dist/js/select2.full.js$ https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js [R=301,L]
RewriteRule ^select2/dist/js/select2.full.js$ https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js [R=301,L]

# Bootstrap Select
RewriteRule ^bootstrap-select/js/bootstrap-select.min.js$ https://cdn.jsdelivr.net/npm/bootstrap-select@1.13.18/dist/js/bootstrap-select.min.js [R=301,L]

# jQuery Validate
RewriteRule ^jquery-validation/jquery.validate.min.js$ https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js [R=301,L]

# Moment.js
RewriteRule ^moment/moment.min.js$ https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js [R=301,L]

# DateRangePicker
RewriteRule ^daterangepicker/daterangepicker.js$ https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js [R=301,L]
RewriteRule ^daterangepicker/daterangepicker.css$ https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css [R=301,L]

# Chart.js
RewriteRule ^chart_3_js/chart_3.0.js$ https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js [R=301,L]
RewriteRule ^chart_3_js/chartjs_plugin.js$ https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js [R=301,L]

# jsPDF
RewriteRule ^jspdf/jspdf.min.js$ https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js [R=301,L]
RewriteRule ^jspdf/html2canvas.js$ https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js [R=301,L]

# JSZip (for DataTables export)
RewriteRule ^jszip/jszip.min.js$ https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js [R=301,L]

# pdfmake
RewriteRule ^pdfmake/pdfmake.min.js$ https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js [R=301,L]
RewriteRule ^pdfmake/vfs_fonts.js$ https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.min.js [R=301,L]

# For any CSS file not matched, return empty CSS
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule \.css$ /HR/plugins/empty.css [L]

# For any JS file not matched, return empty JS
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule \.js$ /HR/plugins/empty.js [L]
